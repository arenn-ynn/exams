# ───────── Frontend (public; safe to expose to the browser) ─────────
# Supabase dashboard → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard → Project Settings → API → "anon" / "publishable" key
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ───────── Server-side only (Vercel functions in /api). NEVER prefix with VITE_ ─────────
# Supabase dashboard → Project Settings → API → "service_role" key. Used ONLY by /api/delete-account.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI examination generator. Choose a provider: "anthropic" or "openai" (openai also covers any OpenAI-compatible API)
AI_PROVIDER=anthropic
# Optional. Defaults: anthropic → claude-sonnet-5-5, openai → gpt-4o-mini
AI_MODEL=
# Fill in the key that matches AI_PROVIDER (leave the other empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1). Default: https://api.openai.com/v1
OPENAI_BASE_URL=
